# PLACE YOUR SUPABASE PROJECT URL AND KEY HERE
# Use the PUBLISHABLE key (sb_publishable_...) for NEXT_PUBLIC_SUPABASE_ANON_KEY.
# NEVER put an sb_secret_ key (or a service_role key) in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_URL=xxxx
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxx
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000

# PLACE YOUR POSTGRES DATABASE URL AND PASSWORD HERE
DATABASE_URL=xxxxx

# PLACE YOUR GOOGLE CLIENT ID AND SECRET HERE TO ENABLE OAUTH SOCIAL LOGIN (https://supabase.com/docs/guides/auth/social-login/auth-google)
GOOGLE_OAUTH_CLIENT_ID=xxxx
GOOGLE_OAUTH_CLIENT_SECRET=xxxx

# Place GITHUB client id and secret to easily enable github oauth login
GITHUB_OAUTH_CLIENT_ID=xxxxx
GITHUB_OAUTH_CLIENT_SECRET=xxxxx
# STRIPE (custom pricing cards on /subscribe use the STRIPE_PRICE_* IDs below)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxx
# Price IDs used by /subscribe custom pricing cards (Stripe Dashboard > Products)
STRIPE_PRICE_STARTER=price_xxxx
STRIPE_PRICE_PRO=price_xxxx
STRIPE_PRICE_PRO_YEARLY=price_xxxx
# Stripe webhook signing secret (`stripe listen` prints it locally; Dashboard > Developers > Webhooks in prod).
# The webhook FAILS CLOSED without this - unsigned payloads are rejected.
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# AI ASSESSMENT GENERATION (OpenAI-compatible Chat Completions)
# Any OpenAI-compatible endpoint works: set OPENAI_BASE_URL (e.g. OpenRouter, Ollama).
# Without OPENAI_API_KEY the dashboard works but assessment generation shows a clear error.
OPENAI_API_KEY=sk-xxxx
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# TRANSCRIPT FETCHING (TranscriptAPI - https://transcriptapi.com/docs/api/)
# Server-side only; fetched transcripts are cached in the `transcripts` table by video ID.
# Without TRANSCRIPTAPI_KEY assessment generation shows a clear "not configured" error.
TRANSCRIPTAPI_KEY=sk_xxxx

# Google Tag Manager (optional) - container renders nothing when unset
NEXT_PUBLIC_GTM_ID="GTM-XXXXXX"
